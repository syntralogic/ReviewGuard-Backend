# Server
PORT=4000
NODE_ENV=development

# Postgres — either DATABASE_URL or the individual PG* vars below
# Local:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reviewguard
# Supabase (use the "Session pooler" string - Render is IPv4-only, the direct
# db.<ref>.supabase.co host is IPv6-only). Don't add ?sslmode=require:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SSL is on automatically when NODE_ENV=production; override with DATABASE_SSL=true|false

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=reviewguard_session

# CORS — the frontend's origin (Lovable dev server / deployed URL)
CLIENT_ORIGIN=http://localhost:8080
